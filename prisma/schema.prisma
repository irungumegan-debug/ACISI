// ACISI data model.
//
// Design notes (see docs/ARCHITECTURE.md for the full rationale):
// - Multi-tenancy: shared tables, scoped by clinicId. Patient records are
//   deliberately clinic-agnostic (no clinicId) — portability across clinics
//   is the core product feature, so a patient exists once and accumulates
//   Encounters at whichever clinics they visit.
// - Data Protection Act minimalism: Patient collects only what's needed for
//   clinical continuity (name, DOB, sex, phone), plus an optional ID document
//   and next of kin (Digital Health Agency certification; legal basis in the
//   Privacy Notice). All wiped on account deletion.
// - Every grant/revoke of cross-clinic data sharing is recorded in Consent,
//   never overwritten, so there is always a full history of what a patient
//   agreed to and when.
// - AuditLog is append-only application-side (no update/delete code paths).
//   Enforcing that at the DB level (e.g. REVOKE UPDATE/DELETE for the app
//   role) is a follow-up hardening step, not done here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  RECEPTIONIST
  CLINICIAN
  DOCTOR
  ADMIN
}

enum Sex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

/// An explicit presence correction, layered on top of login-based presence.
/// Whichever of Staff.lastLoginAt / Staff.presenceOverrideAt is more recent
/// today decides whether a doctor counts as in — see
/// staffService.getDoctorPresenceStatus.
enum StaffPresenceOverride {
  IN
  OUT
}

enum CheckInStatus {
  PENDING_PAYMENT
  PAID
  FAILED
  CANCELLED
  /// A walk-in checked in at the front desk (source WALK_IN): no ACISI
  /// check-in fee is charged and no payment is ever requested. The visit
  /// starts immediately, exactly as if a remote check-in had just been paid.
  NO_FEE
}

/// How a CheckIn came about. REMOTE covers every path that charges the ACISI
/// check-in fee via M-Pesa (USSD, web portal, and staff checking in a booked
/// appointment); WALK_IN is a patient who arrived without checking in and
/// was added at the front desk (see walkInService) — no fee.
enum CheckInSource {
  REMOTE
  WALK_IN
}

/// Which identity document a patient's idNumber comes from.
enum PatientIdType {
  NATIONAL_ID
  PASSPORT
  BIRTH_CERTIFICATE
  /// Kenyan alien (foreign national) ID card.
  ALIEN_ID
}

enum ConsentType {
  CROSS_CLINIC_RECORD_SHARING
  PLATFORM_REGISTRATION
  /// Agreement to receive non-essential SMS from the clinic (e.g. the
  /// walk-in "check in from home next time" invite). Never assumed: no such
  /// SMS is sent unless the latest row of this type is granted=true.
  SMS_CLINIC_MESSAGES
}

enum ActorType {
  PATIENT
  STAFF
  SYSTEM
  /// The platform owner (see PlatformOwner) — the one actor type that can
  /// see across every clinic.
  OWNER
}

/// Purpose of a one-time code sent to a patient's phone. Currently only PIN reset.
enum OtpPurpose {
  PIN_RESET
}

/// Clinical lifecycle of a visit, independent of CheckInStatus (which is
/// payment-only). WAITING is set the moment payment succeeds; a doctor
/// opening the patient moves it to IN_CONSULTATION; submitting the
/// consultation form moves it to READY_FOR_CHECKOUT (front desk's job from
/// there — never set by the doctor's submission itself); front desk
/// checkout moves it to DONE and triggers the visit-summary SMS.
enum EncounterStatus {
  WAITING
  IN_CONSULTATION
  READY_FOR_CHECKOUT
  DONE
}

/// Lifecycle of a future-dated booking, independent of CheckInStatus/
/// EncounterStatus (which only exist once a visit actually starts). REQUESTED
/// is the patient's initial booking; a staff member moves it to CONFIRMED or
/// CANCELLED. COMPLETED is set the moment a CheckIn gets linked to this
/// appointment (see checkInService.initiateCheckIn) — i.e. the patient (or
/// staff on their behalf) actually showed up and started the normal walk-in
/// flow, regardless of whether that CheckIn's own payment later succeeds or
/// fails. Never reopened once CANCELLED or COMPLETED.
enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Clinic {
  id         String   @id @default(cuid())
  name       String
  county     String?
  /// Short numeric code staff give patients to select this clinic within
  /// the shared USSD menu, e.g. "482". Not a phone number, not secret.
  ussdCode   String   @unique
  /// Persistent invite code (e.g. "SUNRISE-7F2K") shared with prospective
  /// doctors/staff so their signup can attach to this clinic. Regenerable by
  /// a clinic admin — regenerating invalidates the old code for future
  /// signups, but never affects staff who already joined with it.
  inviteCode String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  staff            Staff[]
  checkIns         CheckIn[]
  encounters       Encounter[]
  departments      Department[]
  appointments     Appointment[]
  paymentSettings  ClinicPaymentSettings?
  bills            Bill[]
  payments         Payment[]
  legalAcceptances LegalAcceptance[]

  @@map("clinics")
}

/// A clinical department at a clinic (e.g. "General", "Braces"), defined by
/// the clinic itself at registration and in Settings. A CheckIn is routed to
/// exactly one at check-in time; a doctor can work in several (see
/// StaffDepartment). Departments with history are deactivated, never
/// deleted, so past visits keep pointing at them.
model Department {
  id                 String   @id @default(cuid())
  clinicId           String
  clinic             Clinic   @relation(fields: [clinicId], references: [id])
  name               String
  /// Lower-cased, trimmed name — enforces "no duplicate names" case-insensitively.
  nameKey            String
  /// Short code, unique within the clinic (e.g. "GEN", "BRC"); 2–6 upper-case
  /// letters/digits. Stored for future USSD use.
  code               String
  /// Optional consultation fee for this department; null means "use the
  /// clinic's default" (ClinicPaymentSettings.defaultConsultationFeeKes).
  consultationFeeKes Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  staff        Staff[]
  doctors      StaffDepartment[]
  checkIns     CheckIn[]
  appointments Appointment[]

  @@unique([clinicId, nameKey])
  @@unique([clinicId, code])
  @@index([clinicId])
  @@map("departments")
}

/// Which departments a doctor works in (one or more). A doctor's queue,
/// patient access, appointments and automatic assignment all go by these.
model StaffDepartment {
  staffId      String
  staff        Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([staffId, departmentId])
  @@index([departmentId])
  @@map("staff_departments")
}

model Staff {
  id                 String                 @id @default(cuid())
  clinicId           String
  clinic             Clinic                 @relation(fields: [clinicId], references: [id])
  /// System-generated login identifier, e.g. "ACI-STF-7F2K". Never
  /// self-chosen or clinic-supplied. This — not phoneNumber — is what staff
  /// and doctors authenticate with, on both the dashboard and USSD.
  staffCode          String                 @unique
  /// E.164 phone number, e.g. "+2547XXXXXXXX". Contact/SMS purposes only —
  /// never used to authenticate.
  phoneNumber        String                 @unique
  name               String
  /// bcrypt hash of a staff-chosen numeric PIN. Never store or log the raw PIN.
  pinHash            String
  role               StaffRole              @default(RECEPTIONIST)
  /// A doctor's "home" department (the one they signed up to), kept in sync
  /// as their first department for display. Scoping and assignment use
  /// `departments` (StaffDepartment), which can hold several. Null for roles
  /// that aren't department-scoped (front desk, admin).
  departmentId       String?
  department         Department?            @relation(fields: [departmentId], references: [id])
  departments        StaffDepartment[]
  isActive           Boolean                @default(true)
  /// Set on every successful login (DOCTOR role only) — the automatic
  /// "in today" signal. Compared against presenceOverrideAt (whichever is
  /// more recent, restricted to today) to decide current presence; see
  /// staffService.getDoctorPresenceStatus. Not a schedule or a history —
  /// only today's value is ever meaningful.
  lastLoginAt        DateTime?
  /// An explicit "mark in" / "mark out" correction, settable by the doctor
  /// themselves or their clinic admin. Only meaningful when
  /// presenceOverrideAt falls on today; a stale value from a previous day
  /// is ignored, not carried forward.
  presenceOverride   StaffPresenceOverride?
  presenceOverrideAt DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  checkIns              CheckIn[]
  auditLogs             AuditLog[]
  otps                  StaffOtp[]
  assignedEncounters    Encounter[]       @relation("EncounterAssignedDoctor")
  consultedEncounters   Encounter[]       @relation("EncounterConsultedBy")
  billsCreated          Bill[]            @relation("BillCreatedBy")
  paymentsTaken         Payment[]         @relation("PaymentTakenBy")
  paymentsVoided        Payment[]         @relation("PaymentVoidedBy")
  checkedOutEncounters  Encounter[]       @relation("EncounterCheckedOutBy")
  confirmedAppointments Appointment[]     @relation("AppointmentConfirmedBy")
  cancelledAppointments Appointment[]     @relation("AppointmentCancelledBy")
  legalAcceptances      LegalAcceptance[]

  @@index([clinicId])
  @@index([departmentId])
  @@map("staff")
}

model Patient {
  id                 String         @id @default(cuid())
  /// System-generated human-readable ID, e.g. "ACI-7F2K" — separate from
  /// the phone number and from the internal cuid `id`. Usable as an
  /// alternate login identifier alongside the phone number.
  patientCode        String         @unique
  /// E.164 phone number — the primary lookup key, since Africa's Talking
  /// gives us the caller's number on every USSD session.
  phoneNumber        String         @unique
  firstName          String
  lastName           String
  dateOfBirth        DateTime?
  sex                Sex            @default(UNKNOWN)
  county             String?
  /// Optional — collected only via the web portal signup form (not USSD,
  /// which has no practical way to enter one). Never used for login or any
  /// notification besides the staff-initiated visit-summary email at
  /// checkout; no uniqueness constraint since a shared household email is
  /// a reasonable, expected case.
  email              String?
  /// bcrypt hash of the patient's chosen numeric PIN. Everyday login
  /// credential; OTP (see Otp model) is reset-only, not primary login.
  /// Null for a patient registered via USSD check-in who has never set one —
  /// they use the same OTP flow to set their first PIN as to reset it.
  pinHash            String?
  /// Set when the account is deleted, by the patient themselves (portal) or
  /// the platform owner — see patientDeletionService. Deletion wipes every
  /// identifying field above (name, phone, email, DOB, county, PIN) in the
  /// same update, but keeps this row and its Encounters/CheckIns/payments,
  /// now anonymous, so clinics keep their medical and financial records.
  /// Every patient lookup used for login/USSD/OTP excludes deleted rows.
  deletedAt          DateTime?
  deletedByType      ActorType?
  /// "Patient does not want SMS", set by front desk (at walk-in check-in or
  /// on the patient's page). When true, no clinic SMS is sent to them —
  /// no payment receipt, no visit summary, no invite. Off by default.
  smsOptOut          Boolean        @default(false)
  smsOptOutUpdatedAt DateTime?
  /// Identity document, to identify the patient correctly and avoid duplicate
  /// records (needed for Digital Health Agency certification). Optional:
  /// given by the patient at web check-in, or recorded by front desk at a
  /// walk-in or on the patient's page. Always set together with idNumber.
  /// Sensitive — wiped on account deletion like every identifying field.
  idType             PatientIdType?
  /// Normalised: upper case, no spaces (see services/patientIdentity.ts).
  idNumber           String?
  /// Optional next of kin, so the clinic can reach someone on the patient's
  /// behalf. Phone is E.164. Wiped on account deletion.
  nextOfKinName      String?
  nextOfKinPhone     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  consents         Consent[]
  encounters       Encounter[]
  checkIns         CheckIn[]
  otps             Otp[]
  appointments     Appointment[]
  legalAcceptances LegalAcceptance[]

  @@map("patients")
}

/// One-time codes sent by SMS. Currently used only to let a patient who has
/// forgotten their PIN reset it — never for everyday login.
model Otp {
  id         String     @id @default(cuid())
  patientId  String
  patient    Patient    @relation(fields: [patientId], references: [id])
  purpose    OtpPurpose
  /// bcrypt hash of the OTP. Never store or log the raw code.
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([patientId])
  @@map("otps")
}

/// Staff/doctor counterpart of Otp: a one-time code sent by SMS to the
/// staff member's registered phone so they can reset a forgotten PIN
/// themselves. Same rules as Otp — reset-only, never a login credential,
/// hashed, short-lived, limited guesses.
model StaffOtp {
  id         String     @id @default(cuid())
  staffId    String
  staff      Staff      @relation(fields: [staffId], references: [id])
  purpose    OtpPurpose
  /// bcrypt hash of the OTP. Never store or log the raw code.
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([staffId])
  @@map("staff_otps")
}

/// One row per consent grant or revocation. Never mutated after creation —
/// a revoke is a new row with granted=false, so history is always intact.
model Consent {
  id        String      @id @default(cuid())
  patientId String
  patient   Patient     @relation(fields: [patientId], references: [id])
  type      ConsentType
  granted   Boolean
  /// How consent was captured, e.g. "USSD", "STAFF_ASSISTED".
  channel   String
  /// Version identifier of the consent copy shown, so we can reproduce
  /// exactly what the patient agreed to.
  version   String
  createdAt DateTime    @default(now())

  @@index([patientId])
  @@map("consents")
}

/// A single visit at a clinic. Created the moment payment succeeds (status
/// WAITING) — this is both the portable cross-clinic history pointer
/// ("patient X visited clinic Y on date Z") and the doctor's clinical
/// working record for that visit (diagnosis/prescription), which is why it
/// carries EncounterStatus alongside CheckInStatus rather than folding the
/// two together: payment and clinical progress are genuinely independent
/// concerns that just happen to start at the same moment.
model Encounter {
  id                  String          @id @default(cuid())
  patientId           String
  patient             Patient         @relation(fields: [patientId], references: [id])
  clinicId            String
  clinic              Clinic          @relation(fields: [clinicId], references: [id])
  checkInId           String          @unique
  checkIn             CheckIn         @relation(fields: [checkInId], references: [id])
  status              EncounterStatus @default(WAITING)
  /// The doctor this visit is routed to, decided once at the moment the
  /// CheckIn becomes WAITING (see doctorAssignmentService.assignDoctorForCheckIn)
  /// — never reassigned afterward (manual reassignment is future work). Null
  /// only when the department had zero registered doctors at that moment, in
  /// which case the visit stays open to any doctor in the department, same
  /// as before this field existed.
  assignedDoctorId    String?
  assignedDoctor      Staff?          @relation("EncounterAssignedDoctor", fields: [assignedDoctorId], references: [id])
  /// Optional free text a staff member can add later via a richer channel.
  /// Not collected over USSD at MVP.
  visitReason         String?
  /// Set by the doctor's consultation submission — never by the doctor's
  /// mere viewing of the patient.
  diagnosis           String?
  prescription        String?
  consultedByStaffId  String?
  consultedByStaff    Staff?          @relation("EncounterConsultedBy", fields: [consultedByStaffId], references: [id])
  consultedAt         DateTime?
  /// Set by the front-desk checkout action — the point at which the SMS
  /// visit summary goes out. Never set by the doctor's own submission.
  checkedOutByStaffId String?
  checkedOutByStaff   Staff?          @relation("EncounterCheckedOutBy", fields: [checkedOutByStaffId], references: [id])
  checkedOutAt        DateTime?
  createdAt           DateTime        @default(now())

  bill Bill?

  @@index([patientId])
  @@index([clinicId])
  @@index([assignedDoctorId])
  @@map("encounters")
}

model CheckIn {
  id                     String        @id @default(cuid())
  patientId              String
  patient                Patient       @relation(fields: [patientId], references: [id])
  clinicId               String
  clinic                 Clinic        @relation(fields: [clinicId], references: [id])
  /// The staff member who checked the patient in, for staff-initiated
  /// check-ins (walk-ins). Null when the patient checked in themselves.
  staffId                String?
  staff                  Staff?        @relation(fields: [staffId], references: [id])
  source                 CheckInSource @default(REMOTE)
  departmentId           String
  department             Department    @relation(fields: [departmentId], references: [id])
  /// Idempotency guard: one CheckIn per USSD session, so a dropped-session
  /// replay (see docs/ARCHITECTURE.md) can never trigger a second STK push.
  ussdSessionId          String        @unique
  amountKes              Decimal       @db.Decimal(10, 2)
  status                 CheckInStatus @default(PENDING_PAYMENT)
  mpesaCheckoutRequestId String?       @unique
  mpesaMerchantRequestId String?
  /// Set when this arrival fulfills an existing Appointment — either
  /// auto-matched (see checkInService.initiateCheckIn/appointmentService.
  /// findArrivalMatch) or explicitly linked by staff checking the patient in
  /// against a specific booking. Null for an ordinary walk-in with no prior
  /// booking. Setting this also moves the Appointment to COMPLETED.
  appointmentId          String?       @unique
  appointment            Appointment?  @relation(fields: [appointmentId], references: [id])
  createdAt              DateTime      @default(now())
  paidAt                 DateTime?

  encounter         Encounter?
  mpesaTransactions MpesaTransaction[]
  legalAcceptances  LegalAcceptance[]

  @@index([patientId])
  @@index([clinicId])
  @@index([departmentId])
  @@map("check_ins")
}

/// A future-dated request to see a doctor, made through the web portal —
/// entirely separate from CheckIn/Encounter, which model an actual same-day
/// walk-in visit. An Appointment only ever produces a CheckIn (see
/// CheckIn.appointmentId) once the patient actually shows up; until then it
/// carries no payment and no clinical data of its own. Deliberately no
/// concept of a doctor's schedule/capacity here — this just records what was
/// requested, and staff use their own judgment confirming it.
model Appointment {
  id           String            @id @default(cuid())
  patientId    String
  patient      Patient           @relation(fields: [patientId], references: [id])
  clinicId     String
  clinic       Clinic            @relation(fields: [clinicId], references: [id])
  departmentId String
  department   Department        @relation(fields: [departmentId], references: [id])
  /// The date/time the patient asked to come in — a plain request, not a
  /// reserved slot; nothing prevents two patients requesting the same time.
  scheduledFor DateTime
  status       AppointmentStatus @default(REQUESTED)

  confirmedByStaffId String?
  confirmedByStaff   Staff?    @relation("AppointmentConfirmedBy", fields: [confirmedByStaffId], references: [id])
  confirmedAt        DateTime?

  /// Who cancelled it — the patient themselves or a staff member. Null
  /// unless status is CANCELLED.
  cancelledByType    ActorType?
  cancelledByStaffId String?
  cancelledByStaff   Staff?     @relation("AppointmentCancelledBy", fields: [cancelledByStaffId], references: [id])
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIn CheckIn?

  @@index([clinicId, departmentId, scheduledFor])
  @@index([patientId])
  @@map("appointments")
}

/// Whether a clinic's mobile money number is a Buy Goods till or a Paybill.
enum MobileMoneyType {
  TILL
  PAYBILL
}

/// How a clinic gets paid at checkout. Clinic money only ever goes to the
/// clinic's own till/paybill — never ACISI's (which only collects the
/// patient check-in fee). Holds no secrets: Daraja API credentials live in
/// environment variables (see env.ts CLINIC_DARAJA_*), never in the database.
model ClinicPaymentSettings {
  clinicId                  String           @id
  clinic                    Clinic           @relation(fields: [clinicId], references: [id])
  acceptsCash               Boolean          @default(true)
  acceptsCard               Boolean          @default(false)
  acceptsMobileMoney        Boolean          @default(false)
  mobileMoneyType           MobileMoneyType?
  /// The clinic's own till or paybill number.
  mobileMoneyNumber         String?
  /// Paybill account reference template, e.g. "{patientCode}". Placeholders:
  /// {patientCode}, {billNumber}. Ignored for tills.
  paybillAccountFormat      String?
  /// Pre-filled as the first line of every new bill; staff can change it.
  defaultConsultationFeeKes Int              @default(0)
  updatedByStaffId          String?
  updatedAt                 DateTime         @updatedAt

  @@map("clinic_payment_settings")
}

enum BillStatus {
  UNPAID
  PARTLY_PAID
  PAID
}

enum BillItemKind {
  CONSULTATION
  LAB
  MEDICATION
  OTHER
}

/// What the patient owes the clinic for one visit, built by front desk at
/// checkout. All money is whole KES (Int) — never floating point. totalKes =
/// subtotalKes - discountKes; paidKes is the sum of SUCCEEDED payments and
/// status follows from the two. Both are recalculated in the same
/// transaction as every payment or void (see billingService).
model Bill {
  id               String     @id @default(cuid())
  /// Short human-readable number for receipts and paybill references, e.g. "B-7F2K9".
  billNumber       String     @unique
  encounterId      String     @unique
  encounter        Encounter  @relation(fields: [encounterId], references: [id])
  clinicId         String
  clinic           Clinic     @relation(fields: [clinicId], references: [id])
  createdByStaffId String
  createdByStaff   Staff      @relation("BillCreatedBy", fields: [createdByStaffId], references: [id])
  subtotalKes      Int
  discountKes      Int        @default(0)
  /// Required whenever discountKes > 0.
  discountReason   String?
  totalKes         Int
  paidKes          Int        @default(0)
  status           BillStatus @default(UNPAID)
  /// When the bill first became fully paid.
  paidAt           DateTime?
  /// Set (once, atomically) when the paid receipt SMS is sent, so it's never sent twice.
  receiptSmsSentAt DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  items    BillItem[]
  payments Payment[]

  @@index([clinicId, createdAt])
  @@map("bills")
}

model BillItem {
  id          String       @id @default(cuid())
  billId      String
  bill        Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  kind        BillItemKind
  description String
  amountKes   Int
  position    Int

  @@index([billId])
  @@map("bill_items")
}

enum PaymentMethod {
  CASH
  CARD
  /// STK push prompt to the patient's phone, paying the clinic's till/paybill.
  MPESA_STK
  /// An M-Pesa transaction code typed in by staff (prompt failed, or the
  /// patient paid the till directly).
  MPESA_MANUAL
}

enum PaymentStatus {
  /// STK push sent, waiting for the patient / Daraja.
  PENDING
  SUCCEEDED
  FAILED
  /// The patient declined the prompt.
  CANCELLED
  /// No answer from the patient in time.
  TIMED_OUT
  /// Entered by mistake and voided by a clinic admin. Never deleted.
  VOIDED
}

/// One payment towards a bill. Rows are never deleted — a mistake is voided
/// (with who, when and why) and stays on record.
model Payment {
  id                       String        @id @default(cuid())
  billId                   String
  bill                     Bill          @relation(fields: [billId], references: [id])
  clinicId                 String
  clinic                   Clinic        @relation(fields: [clinicId], references: [id])
  method                   PaymentMethod
  status                   PaymentStatus
  amountKes                Int
  /// Cash only: what the patient handed over, and the change given back.
  cashTenderedKes          Int?
  changeKes                Int?
  /// Card: reference or last 4 digits from the clinic's card machine.
  reference                String?
  /// M-Pesa transaction code (STK result or typed in). Unique so a code can
  /// never be used twice; cleared into voidedMpesaReceiptNumber on void so
  /// a mistaken entry doesn't block re-entering the code on the right bill.
  mpesaReceiptNumber       String?       @unique
  voidedMpesaReceiptNumber String?
  mpesaCheckoutRequestId   String?       @unique
  mpesaMerchantRequestId   String?
  phoneNumber              String?
  resultCode               Int?
  resultDesc               String?
  rawCallbackPayload       Json?
  /// Sent by the browser with each payment attempt; a repeat (double click,
  /// retry after a dropped connection) returns the original payment instead
  /// of creating a second one or sending a second M-Pesa prompt.
  idempotencyKey           String        @unique
  takenByStaffId           String
  takenByStaff             Staff         @relation("PaymentTakenBy", fields: [takenByStaffId], references: [id])
  /// When the money was confirmed received (SUCCEEDED).
  completedAt              DateTime?
  voidedAt                 DateTime?
  voidedByStaffId          String?
  voidedByStaff            Staff?        @relation("PaymentVoidedBy", fields: [voidedByStaffId], references: [id])
  voidReason               String?
  createdAt                DateTime      @default(now())

  @@index([billId])
  @@index([clinicId, completedAt])
  @@map("payments")
}

/// One row per Daraja STK push attempt/callback for a CheckIn. A CheckIn can
/// have more than one (e.g. a timed-out push followed by a retry).
model MpesaTransaction {
  id                 String    @id @default(cuid())
  checkInId          String
  checkIn            CheckIn   @relation(fields: [checkInId], references: [id])
  merchantRequestId  String
  checkoutRequestId  String
  resultCode         Int?
  resultDesc         String?
  mpesaReceiptNumber String?   @unique
  transactionDate    DateTime?
  phoneNumber        String
  amountKes          Decimal   @db.Decimal(10, 2)
  /// Full raw Daraja callback body, kept verbatim for reconciliation/audit.
  rawCallbackPayload Json?
  createdAt          DateTime  @default(now())

  @@index([checkInId])
  @@map("mpesa_transactions")
}

/// ACISI's public legal documents (web/src/content/*.md, shown at
/// acisi.co.ke/privacy and /terms).
enum LegalDocument {
  PRIVACY_NOTICE
  TERMS_OF_SERVICE
}

/// Where an acceptance or acknowledgment was captured.
enum LegalAcceptanceContext {
  /// Patient ticked "I accept the Terms … and have read the Privacy Notice" at portal signup.
  PATIENT_SIGNUP
  /// Patient accepted the current Terms on the one-time screen after logging in to the portal.
  PATIENT_PORTAL_LOGIN
  /// Patient acknowledged the Privacy Notice for a clinic when checking in on the web.
  PATIENT_WEB_CHECKIN
  /// Front desk confirmed the patient was told how their data is used and
  /// where to read the Privacy Notice (staffId says who).
  WALK_IN_CHECKIN
  /// Clinic admin accepted both documents when registering the clinic.
  CLINIC_REGISTRATION
  /// Staff member accepted the current Terms on the one-time screen after logging in to the console.
  STAFF_LOGIN
}

/// One row per document accepted or acknowledged. Append-only, like Consent:
/// never updated or deleted, so there is always a record of exactly which
/// version was agreed to, by whom and when. `version` is the document's
/// "Last updated" date (YYYY-MM-DD, see src/config/legal.ts); a new version
/// means everyone is asked again.
model LegalAcceptance {
  id        String                 @id @default(cuid())
  document  LegalDocument
  version   String
  context   LegalAcceptanceContext
  /// The patient who accepted, or whom a walk-in acknowledgment is about.
  patientId String?
  patient   Patient?               @relation(fields: [patientId], references: [id])
  /// The staff member who accepted (staff login, clinic registration), or
  /// who recorded a walk-in acknowledgment on the patient's behalf.
  staffId   String?
  staff     Staff?                 @relation(fields: [staffId], references: [id])
  clinicId  String?
  clinic    Clinic?                @relation(fields: [clinicId], references: [id])
  checkInId String?
  checkIn   CheckIn?               @relation(fields: [checkInId], references: [id])
  createdAt DateTime               @default(now())

  @@index([patientId, document])
  @@index([staffId, document])
  @@index([clinicId])
  @@map("legal_acceptances")
}

/// The company owner's account, for the separate owner site (/owner). Can
/// see every clinic, staff member and patient record across the platform,
/// deactivate clinics and staff, and delete patient accounts — every one of
/// which is written to AuditLog with actorType OWNER. Deliberately not a
/// StaffRole: staff belong to exactly one clinic, an owner belongs to none.
/// Never created through any HTTP endpoint — only via
/// scripts/createOwner.ts, run from the server console.
model PlatformOwner {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  /// bcrypt hash of the owner's password. Never store or log the raw value.
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("platform_owners")
}

/// Append-only. Every access to or mutation of patient data should leave a
/// row here — this is the audit trail the Data Protection Act requires.
model AuditLog {
  id         String    @id @default(cuid())
  actorType  ActorType
  /// Patient.id or Staff.id depending on actorType; null when actorType is SYSTEM.
  actorId    String?
  staffId    String?
  staff      Staff?    @relation(fields: [staffId], references: [id])
  /// e.g. "PATIENT_HISTORY_VIEWED", "CONSENT_GRANTED", "CHECK_IN_CREATED".
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@map("audit_logs")
}
