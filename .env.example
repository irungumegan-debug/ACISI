# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql://acisi:acisi@localhost:5432/acisi

# --- Redis (USSD session state + BullMQ job queue) ---
REDIS_URL=redis://localhost:6379

# --- Africa's Talking ---
# https://account.africastalking.com — use the "sandbox" username for testing.
AT_USERNAME=sandbox
AT_API_KEY=
# The full USSD code assigned to ACISI, e.g. *384*1234#
AT_USSD_SERVICE_CODE=

# --- M-Pesa Daraja (Safaricom) ---
# https://developer.safaricom.co.ke — Lipa Na M-Pesa Online (STK Push) app credentials.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Business shortcode used for the STK push (Paybill/Till registered to ACISI, not the clinic).
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Publicly reachable HTTPS URL where Daraja will POST the STK push result.
MPESA_CALLBACK_URL=https://your-domain.example.com/api/mpesa/callback

# Flat check-in fee charged to the patient at check-in time, in KES.
CHECKIN_FEE_AMOUNT_KES=100

# --- Auth ---
# Salt rounds for hashing clinic staff USSD PINs (bcrypt).
STAFF_PIN_SALT_ROUNDS=10

# --- USSD session behaviour ---
# Must be <= Africa's Talking's own session timeout (~180s) so we never
# read a "fresh" Redis session that AT itself already considers expired.
USSD_SESSION_TTL_SECONDS=170
